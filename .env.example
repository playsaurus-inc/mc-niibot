# Environment (local or production)
APP_ENV=local

# Your Discord bot token from the Discord Developer Portal
DISCORD_TOKEN=

# Your bot's client ID (Application ID) from the Discord Developer Portal
DISCORD_CLIENT_ID=

# The ID of the Discord server (guild) where the bot will operate
DISCORD_GUILD_ID=

# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# Feature flags
RECRUITMENT_FORMAT_ENABLED=true
NITRO_SCAM_MOD_ENABLED=true
INVITE_LINK_MOD_ENABLED=true
GOOGLE_PLAY_SPAM_MOD_ENABLED=true
SLUR_BAN_MOD_ENABLED=true
RAPID_MESSAGE_SPAM_MOD_ENABLED=true
CROSS_CHANNEL_SPAM_MOD_ENABLED=true
